{
  "name": "ebay-mcp",
  "version": "1.14.2",
  "description": "Model Context Protocol (MCP) server that exposes 100% of eBay's Sell APIs (290 tools across 266 endpoints) to AI assistants like Claude, Cursor, and Cline, covering inventory, order fulfillment, marketing, analytics, and developer tools with OAuth authentication and refresh-token support.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "ebay-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias && pnpm run build:ui",
    "build:ui": "tsx src/scripts/buildUi.ts",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.cts",
    "setup": "tsx src/scripts/setup.ts",
    "skills": "tsx src/scripts/skills.ts",
    "sync": "tsx src/scripts/devSync.ts",
    "diagnose": "tsx src/scripts/diagnostics.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "check": "pnpm run typecheck && pnpm run typecheck:ui && pnpm run typecheck:tests && biome check \"{src,ui}/**/*.{ts,tsx,js,json,md,css,html}\"",
    "check:ci": "biome ci . && pnpm run style:guide",
    "style:guide": "tsx scripts/dev/reportCodeStyleGuide.ts",
    "verify": "pnpm run check:ci && pnpm run typecheck && pnpm run typecheck:ui && pnpm run typecheck:tests && pnpm run test && pnpm run build",
    "fix": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true src ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true .",
    "format": "biome format --write .",
    "prepare": "pnpm run build && husky"
  },
  "keywords": [
    "mcp",
    "ebay",
    "ebay-api",
    "model-context-protocol",
    "ai-tools",
    "ai",
    "llm",
    "documentation",
    "api",
    "server",
    "backend"
  ],
  "author": "Yosef Hayim Sabag",
  "license": "MIT",
  "files": [
    "build/index.js",
    "build/serverHttp.js",
    "build/api/**/*.js",
    "build/auth/**/*.js",
    "build/config/**/*.js",
    "build/ebay/**/*.js",
    "build/mcp/**/*.js",
    "build/schemas/**/*.js",
    "build/scripts/**/*.js",
    "build/skills/**/*.js",
    "build/tools/**/*.js",
    "build/utils/**/*.js",
    "build/ui/*.html",
    "build/types/index.js",
    "build/types/ebay.js",
    "build/types/ebayEnums.js",
    "build/index.d.ts",
    "build/serverHttp.d.ts",
    "public/icons/*.png",
    "README.md",
    "docs/auth/production_scopes.json",
    "docs/auth/sandbox_scopes.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/ebay-mcp.git"
  },
  "homepage": "https://github.com/YosefHayim/ebay-mcp#readme",
  "bugs": {
    "url": "https://github.com/YosefHayim/ebay-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "chalk": "5.6.2",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "dotenv-stringify": "3.0.1",
    "effect": "3.21.4",
    "express": "5.2.1",
    "fast-xml-parser": "5.10.1",
    "helmet": "8.3.0",
    "jose": "6.2.7",
    "prompts": "2.4.2",
    "update-notifier": "7.3.1",
    "winston": "3.19.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/prompts": "2.4.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "7.2.1",
    "@types/update-notifier": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "husky": "9.1.7",
    "nock": "14.0.17",
    "openapi-typescript": "7.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supertest": "7.2.2",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
